########################################
# LLM / API 基础配置
########################################

# 通用：优先使用自定义 OpenAI 兼容端点
#   - 如果你希望所有 Heavy/Light 都默认走这个，就保持下面两行存在
CUSTOM_LLM_API_BASE=<YOUR_URL>
CUSTOM_LLM_API_KEY=<YOUR_CUSTOM_LLM_API_KEY>

# Google 端点（仅用于 fallback / 或当 provider=google 时）
GOOGLE_API_KEY=<YOUR_GOOGLE_API_KEY>

# 如果以后需要用 OpenAI 官方，也可以留着（当前没用到可注释）
# OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

########################################
# Heavy / Light LLM 配置
########################################

# ---- Heavy 模型配置（长推理 / prior_art_check 等）----
# role: heavy
# provider:
#   - custom: 走 CUSTOM_LLM_API_BASE / LLM_HEAVY_API_BASE
#   - google: 直接走 Google Gemini（用 GOOGLE_API_KEY）
LLM_HEAVY_PROVIDER=custom
LLM_HEAVY_MODEL=gemini-2.5-flash-thinking

# 若留空，则自动回退到 CUSTOM_LLM_API_BASE / CUSTOM_LLM_API_KEY
LLM_HEAVY_API_BASE=
LLM_HEAVY_API_KEY=

# ---- Light 模型配置（关键词生成 / 小改写 / 进度 note）----
# role: light
LLM_LIGHT_PROVIDER=custom
LLM_LIGHT_MODEL=gemini-2.5-flash-thinking

# 若留空，则自动回退到 CUSTOM_LLM_API_BASE / CUSTOM_LLM_API_KEY
LLM_LIGHT_API_BASE=
LLM_LIGHT_API_KEY=

########################################
# 文献检索 / 外部服务配置
########################################

# OpenAlex
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_MAILTO=<YOUR_EMAIL>

# Semantic Scholar
Semantic_Scholar_URL=https://api.semanticscholar.org/graph/v1
Semantic_Scholar_API_key=<YOUR_SEMANTIC_SCHOLAR_KEY>

# SerpAPI（如果有用）
SERPAPI_API_KEY=<YOUR_SERPAPI_KEY>
# 你之前叫 SERP_API，建议统一成 SERPAPI_API_KEY，并在代码里也改名

########################################
# 其他可选（如果你未来启用）
########################################

