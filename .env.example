# ========================================
# API Keys and Endpoints Configuration Template
# ========================================
# Copy this file to .env and fill in your actual API keys
# .env is gitignored for security

# ---------- Custom LLM Endpoint (Primary) ----------
# This is your cheap proxy endpoint that supports multiple model providers
CUSTOM_LLM_API_BASE=your_URL
CUSTOM_LLM_API_KEY=your-custom-api-key-here
CUSTOM_LLM_MODEL_NAME=gpt-4o-mini

# Recommended models (uncomment to change):
# CUSTOM_LLM_MODEL_NAME=gpt-4o                    # More capable
# CUSTOM_LLM_MODEL_NAME=claude-3-5-sonnet-20241022  # Claude alternative
# CUSTOM_LLM_MODEL_NAME=deepseek-reasoner         # For reasoning tasks

# ---------- Official OpenAI (Optional Backup) ----------
# Only needed if you want to use official OpenAI sometimes
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_API_BASE=https://api.openai.com/v1

# ---------- Google Gemini (For File API / RAG) ----------
# Used specifically for Gemini File API and multimodal features
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL_NAME=gemini-1.5-flash

# ========================================
# Research Tool API Keys
# ========================================

# OpenAlex (Paper discovery - free, just need email)
OPENALEX_MAILTO=your-email@example.com

# Semantic Scholar API (optional - increases rate limits)
Semantic_Scholar_API_key=your-s2-key-here-optional

# SerpAPI (Web search - optional)
SERPAPI_API_KEY=your-serpapi-key-here-optional

# Jina AI (Web scraping - optional)
# JINA_API_KEY=your-jina-key-here

# ========================================
# Model Configuration
# ========================================

# Default model for most operations (uses CUSTOM_LLM endpoint)
MODEL_NAME=${CUSTOM_LLM_MODEL_NAME}

# ========================================
# Application Settings
# ========================================

# Maximum exploration rounds for research tasks
MAX_EXPLORATION_ROUNDS=2

# Enable/disable free search tools
USE_FREE_SEARCH=true
